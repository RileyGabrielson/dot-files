#!/usr/bin/env bash
# Usage: godot [args...]
# Wraps the macOS Godot.app so `godot` works from the shell. Tries common
# install locations and execs the first one that exists.
for app in \
	"$HOME/Desktop/Godot.app/Contents/MacOS/Godot" \
	"/Applications/Godot.app/Contents/MacOS/Godot" \
	"$HOME/Applications/Godot.app/Contents/MacOS/Godot" \
	"$HOME/.local/opt/godot-4.4/Godot_v4.4-stable_linux.x86_64"; do
	if [ -x "$app" ]; then
		exec "$app" "$@"
	fi
done
echo "godot: Godot not found in Desktop, /Applications, ~/Applications, or ~/.local/opt/godot-4.4" >&2
exit 1
