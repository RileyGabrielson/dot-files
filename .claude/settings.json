{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:storage.googleapis.com)",
      "Read",
      "Glob",
      "Grep",
      "Search",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(jq:*)",
      "Bash(largest-files:*)",
      "Bash(git remote get-url *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git check-ignore *)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(gh api:*)",
      "Bash(icalBuddy:*)",
      "Bash(date:*)"
    ],
    "deny": [
      "Bash(git push * --force)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-comments.py --record-baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-comments.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '[(.context_window.used_percentage // empty | \"\\u001b[1;97m\\(. | floor)%\\u001b[0m\"), (.rate_limits.five_hour.used_percentage // empty | \"\\u001b[1;96m5h:\\(. | floor)%\\u001b[0m\")] | join(\" \")'",
    "padding": 0
  },
  "enabledPlugins": {
    "tcn@tcn-marketplace": true,
    "tcn-frontend@tcn-marketplace": true,
    "cloudflare@cloudflare": true,
    "stripe@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "tcn-marketplace": {
      "source": {
        "source": "git",
        "url": "https://git.tcncloud.net/tcn-internal/ai-instructions.git"
      },
      "autoUpdate": true
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "switchModelsOnFlag": false
}
